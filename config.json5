// Renovate's configuration for every repository the workflow runs against.
// A repository can add or override settings with its own renovate.json, but
// needs none.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  platform: 'github',
  onboarding: false,
  requireConfig: 'optional',

  // Commits go through GitHub's API, so GitHub signs them as octo-sts[bot],
  // the app whose token Renovate runs with.
  platformCommit: 'enabled',
  gitAuthor: 'octo-sts[bot] <157150467+octo-sts[bot]@users.noreply.github.com>',

  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
  ],
  // config:recommended groups monorepos and some well-known packages into
  // pull requests of their own, which would split an ecosystem's updates.
  ignorePresets: ['group:monorepos', 'group:recommended'],

  // Grouping keeps the number of pull requests small, so they aren't
  // rate-limited.
  prHourlyLimit: 0,

  // Every update auto-merges, through GitHub's own auto-merge, once the
  // branch's required checks pass.
  automerge: true,
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: true,

  postUpdateOptions: ['gomodTidy'],

  // Each ecosystem's updates, major ones included, share one pull request.
  // A major update that needs code changes fails CI and holds the pull
  // request for a person.
  separateMajorMinor: false,
  packageRules: [
    {
      // Renovate skips indirect Go modules by default, but govulncheck in CI
      // fails on their vulnerabilities too, so they're kept current.
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      enabled: true,
    },
    {
      // A major version of a Go module from v1 on is a different module, and
      // which one an indirect dependency uses is up to the module that
      // requires it. Moving from v0 to v1 keeps the module path.
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchUpdateTypes: ['major'],
      matchCurrentVersion: '>=1.0.0',
      enabled: false,
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
    {
      matchManagers: ['gomod'],
      groupName: 'Go modules',
    },
  ],
}
